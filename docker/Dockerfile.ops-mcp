# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE}

# Enforce October 2026 Node 22 LTS security baseline (>= 22.23.4).
RUN node -e 'const [maj,min,pat]=process.versions.node.split(".").map(Number); if(maj<22||(maj===22&&(min<23||(min===23&&pat<4)))){console.error(`ERROR: Node.js ${process.versions.node} is below the 22.23.4 security baseline. Pull a newer base image or pass --build-arg NODE_IMAGE=node:22.23.4-bookworm-slim.`);process.exit(1);}'

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      openssh-client \
      tini \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g mcp-proxy @uarlouski/ssh-mcp-server \
    && npm cache clean --force \
    && mkdir -p /etc/ops-ssh /srv/ops-mcp \
    && chown -R node:node /etc/ops-ssh /srv/ops-mcp

COPY --chown=node:node docker/ops-mcp-auth-proxy.mjs /srv/ops-mcp/ops-mcp-auth-proxy.mjs

WORKDIR /srv/ops-mcp

LABEL org.opencontainers.image.title="GeminiBastionMCP ops-mcp Sidecar" \
      org.opencontainers.image.source="https://github.com/Kaiserunix/gemini-bastion-mcp" \
      org.opencontainers.image.licenses="MIT"

USER node

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:9000/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["bash", "-c", "mcp-proxy --port 9001 --host 127.0.0.1 --server stream -- ssh-mcp-server --configPath=/etc/ops-ssh/config.json & MCP_PID=$!; node /srv/ops-mcp/ops-mcp-auth-proxy.mjs & PROXY_PID=$!; trap 'kill $MCP_PID $PROXY_PID 2>/dev/null || true' TERM INT; wait -n $MCP_PID $PROXY_PID; CODE=$?; kill $MCP_PID $PROXY_PID 2>/dev/null || true; exit $CODE"]
