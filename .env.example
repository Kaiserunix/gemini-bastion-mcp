# ==============================================================================
# GeminiBastionMCP (gemini-bastion-mcp) Environment Configuration
# ==============================================================================

# Server & Network
PORT=8787
PUBLIC_DOMAIN=https://mcp.example.com
TRUST_CF_CONNECTING_IP=true
LOG_LEVEL=info

# Storage Directories (keep ARTIFACTS_DIR and DATA_DIR strictly outside WORKSPACES_DIR)
DATA_DIR=/data
WORKSPACES_DIR=/workspaces
ARTIFACTS_DIR=/data/artifacts

# Admin Console Authentication for /admin and OAuth consent
# Recommended (Docker-Compose-safe, no $ interpolation): scrypt:<saltHex>:<keyHex>
# Also supported: scrypt$<saltHex>$<keyHex> (escape $ as $$ in Docker Compose .env), sha256:<hex>, sha256$<hex>
ADMIN_PASSWORD_HASH=

# OAuth 2.1 + PKCE + DCR Configuration
# Generate >=32 random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_SIGNING_SECRET=
OAUTH_STATIC_CLIENT_ID=
OAUTH_STATIC_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_HOSTS=gemini.google.com,aistudio.google.com,accounts.google.com,localhost,127.0.0.1

# GitHub Integration (used ONLY in gateway process; NEVER exposed to workspace_exec/Codex)
GH_TOKEN=

# Cloudflare Integration (READONLY token used for infra_inspect; API token used for publish_changes)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_READONLY_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# OpenAI / Codex SDK Runner Configuration
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_DEFAULT_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium
CODEX_MAX_DURATION_SEC=300
CODEX_TOKEN_BUDGET=200000

# Optional Webhook Notifications (job completion, plan execution, failures)
NOTIFY_WEBHOOK_URL=

# Optional Downstream MCP-2 Federation (JSON string OR path to JSON file)
DOWNSTREAM_MCPS_JSON=
DOWNSTREAM_MCPS_FILE=
