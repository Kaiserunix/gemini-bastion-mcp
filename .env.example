# ==============================================================================
# GeminiBastionMCP (gemini-bastion-mcp) Environment Configuration
# ==============================================================================

# Server & Network
PORT=8787
PUBLIC_DOMAIN=https://mcp.example.com
TRUST_CF_CONNECTING_IP=true
LOG_LEVEL=info

# Storage Directories (keep ARTIFACTS_DIR and DATA_DIR strictly outside WORKSPACES_DIR)
DATA_DIR=/data
WORKSPACES_DIR=/workspaces
ARTIFACTS_DIR=/data/artifacts

# Admin Console Authentication for /admin and OAuth consent
# Recommended (Docker-Compose-safe, no $ interpolation): scrypt:<saltHex>:<keyHex>
# Also supported: scrypt$<saltHex>$<keyHex> (escape $ as $$ in Docker Compose .env), sha256:<hex>, sha256$<hex>
ADMIN_PASSWORD_HASH=

# OAuth 2.1 + PKCE + DCR Configuration
# Generate >=32 random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_SIGNING_SECRET=
OAUTH_STATIC_CLIENT_ID=
OAUTH_STATIC_CLIENT_SECRET=
OAUTH_ALLOWED_REDIRECT_HOSTS=gemini.google.com,aistudio.google.com,accounts.google.com,localhost,127.0.0.1

# Optional Upstream Identity Providers for /admin/login & /oauth/authorize (FAIL-CLOSED)
# Google OAuth callback URL: https://<PUBLIC_DOMAIN>/auth/idp/google/callback
# Enabled ONLY when Client ID, Client Secret, AND non-empty GOOGLE_OAUTH_ALLOWED_EMAILS are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_EMAILS=

# GitHub OAuth callback URL: https://<PUBLIC_DOMAIN>/auth/idp/github/callback
# Enabled ONLY when Client ID, Client Secret, AND non-empty GITHUB_OAUTH_ALLOWED_USERS or GITHUB_OAUTH_ALLOWED_IDS are set.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_ALLOWED_USERS=
GITHUB_OAUTH_ALLOWED_IDS=

# GitHub Integration (used ONLY in gateway process; NEVER exposed to workspace_exec/Codex)
GH_TOKEN=

# Cloudflare Integration (READONLY token used for infra_inspect; API token used for publish_changes)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_READONLY_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=

# OpenAI / Codex SDK & Multi-Agent Driver Configuration
DEFAULT_AGENT_DRIVER=codex
OPENAI_API_KEY=
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_DEFAULT_MODEL=gpt-5.3-codex
CODEX_REASONING_EFFORT=medium
CODEX_MAX_DURATION_SEC=300
CODEX_TOKEN_BUDGET=200000
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Sandbox Isolation (bwrap per-workspace FS/network isolation on Linux)
SANDBOX_BWRAP_ISOLATION=true
SANDBOX_STRICT_ISOLATION=false

# Optional Dedicated Isolated Runner Sidecar (recommended for high-isolation deployments)
# In NODE_ENV=production, AGENT_RUNNER_AUTH_TOKEN must be >= 24 chars whenever AGENT_RUNNER_URL is set.
AGENT_RUNNER_URL=
AGENT_RUNNER_AUTH_TOKEN=

# Optional Webhook Notifications (job completion, plan execution, failures)
NOTIFY_WEBHOOK_URL=

# Optional Downstream MCP-2 Federation (JSON string OR path to JSON file) + ops-mcp Bearer Auth
OPS_MCP_AUTH_TOKEN=
DOWNSTREAM_MCPS_JSON=
DOWNSTREAM_MCPS_FILE=
